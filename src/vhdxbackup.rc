#include <winver.h>
#include <winuser.h>

1 24 "vhdxbackup.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,5,0,0
 PRODUCTVERSION 0,5,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040704B0"
    BEGIN
      VALUE "FileDescription", "VhdxBackup - Image-Backup als VHDX"
      VALUE "FileVersion", "0.5.0"
      VALUE "ProductName", "VhdxBackup"
      VALUE "ProductVersion", "0.5.0"
      VALUE "OriginalFilename", "vhdxbackup.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0407, 1200
  END
END
